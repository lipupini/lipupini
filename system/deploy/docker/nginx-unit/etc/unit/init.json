{
	"listeners": {
		"*:8080": {
			"pass": "routes"
		}
	},
	"routes": [
		{
			"action": {
				"share": "/app/src/Lukinview/webroot/$uri",
				"fallback": {
					"pass": "applications/app"
				}
			}
		}
	],
	"applications": {
		"app": {
			"type": "php",
			"root": "/app/src/Lukinview/webroot",
			"script": "index.php",
			"user": "root",
			"group": "root"
		}
	}
}
